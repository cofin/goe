"""Backward-compatible wrapper delegating to 'goe report'."""

import sys
import warnings

from goe.cli.main import cli

if __name__ == "__main__":
    warnings.warn(
        "Invoking 'bin/offload_status_report' is deprecated and will be removed in GOE 2.0.0. Please use 'goe report' instead.",
        DeprecationWarning,
        stacklevel=1,
    )
    sys.argv.insert(1, "report")
    cli()
