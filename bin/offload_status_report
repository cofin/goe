"""Backward-compatible wrapper delegating to 'goe report'."""

import sys
import warnings

from goe.cli.main import cli

if __name__ == "__main__":
    warnings.warn(
        "Invoking 'bin/offload_status_report' is deprecated. Please use 'goe report' instead.",
        DeprecationWarning,
        stacklevel=1,
    )
    sys.argv.insert(1, "report")
    cli()
