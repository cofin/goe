"""Backward-compatible wrapper delegating to 'goe connect'."""

import sys
import warnings

from goe.cli.main import cli

if __name__ == "__main__":
    warnings.warn(
        "Invoking 'bin/connect' is deprecated. Please use 'goe connect' instead.",
        DeprecationWarning,
        stacklevel=1,
    )
    sys.argv.insert(1, "connect")
    cli()
