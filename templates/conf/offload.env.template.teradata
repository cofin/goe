# ===========================================================================================
# Teradata settings
# ===========================================================================================

# Frontend distribution:
FRONTEND_DISTRIBUTION=TERADATA

# Teradata connection settings
TERADATA_SERVER=
TERADATA_ADM_USER=goe_adm
TERADATA_ADM_PASS=
TERADATA_APP_USER=goe_app
TERADATA_APP_PASS=
TERADATA_REPO_USER=goe_repo

# Name of the Teradata ODBC driver as specified in odbcinst.ini
FRONTEND_ODBC_DRIVER_NAME="Teradata Database ODBC Driver 17.10"
